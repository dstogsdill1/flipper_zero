# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="stogs_rf_bridge",  # Must be unique
    name="App stogs_rf_bridge",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    entry_point="stogs_rf_bridge_app",
    stack_size=2 * 1024,
    fap_category="Examples",
    # Optional values
    # fap_version="0.1",
    fap_icon="stogs_rf_bridge.png",  # 10x10 1-bit PNG
    # fap_description="A simple app",
    # fap_author="J. Doe",
    # fap_weburl="https://github.com/user/stogs_rf_bridge",
    fap_icon_assets="images",  # Image assets to compile for this application
    sources=["*.c"],  # Only compile root .c files (exclude Micro_SD_Clone/)
)
